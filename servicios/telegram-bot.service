[Unit]
Description=Telegram Bot API (comandos + @mención)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root

# Bot API (comandos + botones + @mención)
ExecStart=/usr/bin/docker compose -f /home/jorge/dev/devjobs/downloader_telegram/docker-compose.yml up -d telegram_bot

ExecStop=/usr/bin/docker compose -f /home/jorge/dev/devjobs/downloader_telegram/docker-compose.yml stop telegram_bot

[Install]
WantedBy=multi-user.target
