FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc python3-dev ffmpeg tesseract-ocr tesseract-ocr-spa curl unzip && \
    rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deno.land/install.sh | sh && \
    ln -s /root/.deno/bin/deno /usr/local/bin/deno

RUN pip install --no-cache-dir yt-dlp

# Patch ok.ru extractor: metadata can be a dict instead of str
RUN sed -i 's/metadata = self._parse_json(metadata, video_id)/if isinstance(metadata, str):\n                metadata = self._parse_json(metadata, video_id)/' \
    /usr/local/lib/python3.12/site-packages/yt_dlp/extractor/odnoklassniki.py

WORKDIR /app

COPY requirements_bot.txt .
RUN pip install --no-cache-dir -r requirements_bot.txt

COPY app/ /app/app/

CMD ["python", "-u", "/app/app/telegram_bot.py"]
